# Nazwa i wersja aplikacji
APP_NAME="Waterdeep Watchtower"
APP_VERSION="1.0.0"

# Ścieżka do bazy danych (SQLite lokalnie lub zewnętrzny PostgreSQL)
DATABASE_URL="sqlite:///./waterdeep.db"
# DATABASE_URL="postgresql://uzytkownik:haslo@localhost:5432/waterdeep"

# Domyślne dane logowania użytkownika tworzone przy inicjalizacji bazy
DEFAULT_USER_USERNAME="admin"
DEFAULT_USER_PASSWORD="HasloAdministratora123!"

# Czas ważności tokenu sesji w sekundach (domyślnie 24 godziny)
TOKEN_EXPIRATION_SECONDS=86400
